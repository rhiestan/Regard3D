{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "regard3d",
  "version": "1.0.0",
  "description": "Regard3D - open source structure-from-motion application based on OpenMVG",
  "homepage": "http://www.regard3d.org",
  "license": "MIT",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "assimp",
    "boost-accumulators",
    "boost-chrono",
    "boost-date-time",
    "boost-filesystem",
    "boost-geometry",
    "boost-locale",
    "boost-serialization",
    "boost-system",
    "boost-thread",
    "boost-timer",
    {
      "name": "ceres",
      "features": [
        "lapack",
        "suitesparse"
      ]
    },
    "eigen3",
    "flann",
    "glog",
    "openblas",
    {
      "name": "opencv4",
      "features": [
        "eigen",
        "openmp"
      ]
    },
    {
      "name": "openmvg",
      "features": [
        "openmp",
        "software"
      ]
    },
    "osg",
    "suitesparse",
    "vlfeat",
    "wxwidgets"
  ]
}
