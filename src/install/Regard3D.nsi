; Regard3D.nsi
;
; Installer script for the Nullsoft Scriptable Install System (NSIS 3),
; https://nsis.sourceforge.io/
;
; makensis runs in the directory of this script, which relative paths refer to.
;
; Packs a staged installation, as .github/ci/stage-windows.sh produces it:
;
;   makensis -DSTAGE_DIR=<dir> -DUNINSTALL_LIST=<file.nsh>
;            [-DVCREDIST=<vc_redist.x64.exe>] [-DOUTFILE=<setup.exe>] Regard3D.nsi
;
; STAGE_DIR       everything that is installed: Regard3D.exe, its DLLs, the
;                 external tools in their subdirectories, licenses
; UNINSTALL_LIST  Delete/RMDir commands for exactly the files and
;                 directories in STAGE_DIR (generated by package-windows.sh)
; VCREDIST        the Visual C++ Redistributable (x64), run silently when given
; OUTFILE         the installer to write (absolute, or relative to this script)
;
;--------------------------------

Unicode true
ManifestDPIAware true

!include MUI2.nsh
!include x64.nsh
!include LogicLib.nsh

!ifndef STAGE_DIR
	!error "STAGE_DIR is not defined, see the top of this file"
!endif
!ifndef UNINSTALL_LIST
	!error "UNINSTALL_LIST is not defined, see the top of this file"
!endif

!searchparse /file "..\version.h" "#define REGARD3D_VERSION_MAJOR " VER_MAJOR
!searchparse /file "..\version.h" "#define REGARD3D_VERSION_MINOR " VER_MINOR
!searchparse /file "..\version.h" "#define REGARD3D_VERSION_BUILD " VER_BUILD
!searchparse /file "..\version.h" '#define REGARD3D_NAME "' APP_NAME '"'
!searchparse /file "..\version.h" '#define REGARD3D_COPYRIGHT_NAME "' COMPANY_NAME '"'
!searchparse /file "..\version.h" '#define REGARD3D_COPYRIGHT_YEAR "' COPYRIGHT_YEAR '"'
!define VERSION "${VER_MAJOR}.${VER_MINOR}.${VER_BUILD}"

!define REG_KEY "Software\hiesti.ch\Regard3D"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Regard3D"

Name "Regard3D ${VERSION}"
!ifdef OUTFILE
	OutFile "${OUTFILE}"
!else
	OutFile "Regard3D_${VERSION}_Setup.exe"
!endif

; Default installation directory, or the one of an earlier installation
InstallDir "$PROGRAMFILES64\Regard3D"
InstallDirRegKey HKCU "${REG_KEY}" ""

RequestExecutionLevel admin
SetCompressor /SOLID lzma

VIAddVersionKey "ProductName" "${APP_NAME}"
VIAddVersionKey "Comments" "Installer for ${APP_NAME}"
VIAddVersionKey "CompanyName" "${COMPANY_NAME}"
VIAddVersionKey "LegalCopyright" "Copyright (C) ${COPYRIGHT_YEAR} ${COMPANY_NAME}"
VIAddVersionKey "FileDescription" "Installer for ${APP_NAME}"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIProductVersion "${VERSION}.0"

; Do not jump to the finish page, so that the log can be checked
!define MUI_FINISHPAGE_NOAUTOCLOSE
!define MUI_UNFINISHPAGE_NOAUTOCLOSE
!define MUI_ICON "..\res\win\regard3d.ico"
!define MUI_UNICON "..\res\win\regard3d.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "${NSISDIR}\Contrib\Graphics\Header\nsis3-grey.bmp"
!define MUI_HEADERIMAGE_UNBITMAP "${NSISDIR}\Contrib\Graphics\Header\nsis3-grey.bmp"
!define MUI_FINISHPAGE_RUN "$INSTDIR\Regard3D.exe"
!define MUI_LANGDLL_REGISTRY_ROOT HKCU
!define MUI_LANGDLL_REGISTRY_KEY "${REG_KEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Installer Language"

Var StartMenuFolder

;--------------------------------
; Pages

!insertmacro MUI_PAGE_LICENSE "..\licenses\Copyright.txt"
!insertmacro MUI_PAGE_DIRECTORY

!define MUI_STARTMENUPAGE_REGISTRY_ROOT HKCU
!define MUI_STARTMENUPAGE_REGISTRY_KEY "${REG_KEY}"
!define MUI_STARTMENUPAGE_REGISTRY_VALUENAME "Start Menu Folder"
!define MUI_STARTMENUPAGE_DEFAULTFOLDER "Regard3D"
!insertmacro MUI_PAGE_STARTMENU Application $StartMenuFolder

!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "French"
!insertmacro MUI_LANGUAGE "German"
!insertmacro MUI_RESERVEFILE_LANGDLL

LangString Message64bit ${LANG_ENGLISH} "Regard3D is a 64-bit program and can't be installed on a 32-bit version of Windows."
LangString Message64bit ${LANG_FRENCH} "Regard3D est un programme 64 bits et ne peut pas être installé sur une version 32 bits de Windows."
LangString Message64bit ${LANG_GERMAN} "Regard3D ist ein 64-Bit-Programm und kann nicht auf einer 32-Bit-Version von Windows installiert werden."

;--------------------------------
; Sections

!ifdef VCREDIST
; The MSVC runtime (msvcp140, vcruntime140, vcomp140) that Regard3D, the
; vcpkg libraries and the external tools use
Section "Visual C++ Redistributable" Section_VCRedist
	SectionIn RO
	InitPluginsDir
	SetOutPath $PLUGINSDIR
	File "/oname=vc_redist.x64.exe" "${VCREDIST}"
	DetailPrint "Installing the Visual C++ Redistributable (x64)"
	ExecWait '"$PLUGINSDIR\vc_redist.x64.exe" /install /quiet /norestart' $0
	; 1638: a newer version is already installed; 3010: restart required
	${If} $0 == 3010
		SetRebootFlag true
	${ElseIf} $0 != 0
	${AndIf} $0 != 1638
		DetailPrint "The Visual C++ Redistributable returned $0"
	${EndIf}
	Delete "$PLUGINSDIR\vc_redist.x64.exe"
SectionEnd
!endif

Section "Regard3D" Section_Main
	SectionIn RO

	; The tools of an earlier version, which File /r would only overwrite
	; (e.g. Regard3D 1.0's smvsrecon_SSE41 would stay behind in mve\)
	RMDir /r "$INSTDIR\openmvg"
	RMDir /r "$INSTDIR\pmvs"
	RMDir /r "$INSTDIR\poisson"
	RMDir /r "$INSTDIR\mve"
	; Libraries only Regard3D 1.0 used
	Delete "$INSTDIR\flang.dll"
	Delete "$INSTDIR\flangrti.dll"
	Delete "$INSTDIR\openblas.dll"

	SetOutPath $INSTDIR
	File /r "${STAGE_DIR}\*.*"
	WriteUninstaller "$INSTDIR\Uninstall.exe"

	WriteRegStr HKCU "${REG_KEY}" "" $INSTDIR
	WriteRegStr HKCU "${REG_KEY}" "ExternalEXEPath" $INSTDIR
	; Regard3D 1.0 installed the font and the sensor database in the local
	; application data directory. Both are now next to Regard3D.exe, which
	; is used when these are not set.
	DeleteRegValue HKCU "${REG_KEY}" "FontFilename"
	DeleteRegValue HKCU "${REG_KEY}" "CameraDBFilename"
	Delete "$LOCALAPPDATA\Regard3D\DejaVuSans.ttf"
	Delete "$LOCALAPPDATA\Regard3D\sensor_database.csv"
	; Only if empty: the user camera database (usercamera.db) stays
	RMDir "$LOCALAPPDATA\Regard3D"

	!insertmacro MUI_STARTMENU_WRITE_BEGIN Application
		CreateDirectory "$SMPROGRAMS\$StartMenuFolder"
		CreateShortCut "$SMPROGRAMS\$StartMenuFolder\Regard3D.lnk" "$INSTDIR\Regard3D.exe"
		CreateShortCut "$SMPROGRAMS\$StartMenuFolder\Licenses.lnk" "$INSTDIR\licenses"
		CreateShortCut "$SMPROGRAMS\$StartMenuFolder\Uninstall.lnk" "$INSTDIR\Uninstall.exe"
	!insertmacro MUI_STARTMENU_WRITE_END

	WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayName" "Regard3D"
	WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
	WriteRegStr HKLM "${UNINSTALL_KEY}" "Publisher" "${COMPANY_NAME}"
	WriteRegStr HKLM "${UNINSTALL_KEY}" "URLInfoAbout" "http://www.regard3d.org"
	WriteRegStr HKLM "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
	WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayIcon" "$\"$INSTDIR\Regard3D.exe$\""
	WriteRegStr HKLM "${UNINSTALL_KEY}" "UninstallString" "$\"$INSTDIR\Uninstall.exe$\""
	WriteRegStr HKLM "${UNINSTALL_KEY}" "QuietUninstallString" "$\"$INSTDIR\Uninstall.exe$\" /S"
	WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoModify" 1
	WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoRepair" 1
SectionEnd

Function .onInit
	${If} ${RunningX64}
		SetRegView 64
	${Else}
		MessageBox MB_OK|MB_ICONSTOP $(Message64bit)
		Abort
	${EndIf}
	!insertmacro MUI_LANGDLL_DISPLAY
FunctionEnd

;--------------------------------
; Uninstaller

Section "Uninstall"
	; Exactly what was installed, see UNINSTALL_LIST
	!include "${UNINSTALL_LIST}"
	Delete "$INSTDIR\Uninstall.exe"
	RMDir "$INSTDIR"

	!insertmacro MUI_STARTMENU_GETFOLDER Application $StartMenuFolder
	Delete "$SMPROGRAMS\$StartMenuFolder\Regard3D.lnk"
	Delete "$SMPROGRAMS\$StartMenuFolder\Licenses.lnk"
	Delete "$SMPROGRAMS\$StartMenuFolder\Uninstall.lnk"
	RMDir "$SMPROGRAMS\$StartMenuFolder"

	DeleteRegValue HKCU "${REG_KEY}" ""
	DeleteRegValue HKCU "${REG_KEY}" "ExternalEXEPath"
	DeleteRegValue HKCU "${REG_KEY}" "Start Menu Folder"
	DeleteRegValue HKCU "${REG_KEY}" "Installer Language"
	DeleteRegKey /ifempty HKCU "${REG_KEY}"
	DeleteRegKey HKLM "${UNINSTALL_KEY}"
SectionEnd

Function un.onInit
	${If} ${RunningX64}
		SetRegView 64
	${EndIf}
	!insertmacro MUI_UNGETLANGUAGE
FunctionEnd
